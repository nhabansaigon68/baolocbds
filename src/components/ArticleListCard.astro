---
interface Props {
  href: string;
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
  pubDate: Date;
}

const {
  href,
  title,
  description,
  imageUrl,
  imageAlt,
  pubDate,
} = Astro.props;
---

<article class="article-card">
  <a
    href={href}
    class="article-card-image-link"
    aria-label={title}
  >
    <img
      src={imageUrl}
      alt={imageAlt}
      width="700"
      height="450"
      loading="lazy"
      class="article-card-image"
    />
  </a>

  <div class="article-card-content">
    <time
      datetime={pubDate.toISOString()}
      class="article-card-date"
    >
      {pubDate.toLocaleDateString("vi-VN")}
    </time>

    <h2 class="article-card-title">
      <a href={href}>
        {title}
      </a>
    </h2>

    <p class="article-card-description">
      {description}
    </p>

    <a
      href={href}
      class="article-card-read-more"
    >
      Đọc thêm →
    </a>
  </div>
</article>

<style>
  .article-card {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 28px;

    padding: 18px;

    border: 1px solid rgba(23, 23, 23, 0.10);
    border-radius: 16px;

    background: rgba(255, 255, 255, 0.48);

    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: rgba(23, 23, 23, 0.18);
    box-shadow: 0 12px 34px rgba(23, 23, 23, 0.06);
  }

  .article-card-image-link {
    display: block;
    overflow: hidden;
    border-radius: 12px;
    background: #ecebe6;
  }

  .article-card-image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 14 / 9;

    object-fit: cover;

    transition: transform 300ms ease;
  }

  .article-card:hover .article-card-image {
    transform: scale(1.025);
  }

  .article-card-content {
    min-width: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .article-card-date {
    margin-bottom: 10px;

    color: #77766f;
    font-size: 13px;
  }

  .article-card-title {
    margin: 0;

    color: #171717;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .article-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .article-card-description {
    margin: 12px 0 0;

    color: #686860;
    font-size: 15px;
    line-height: 1.65;
  }

  .article-card-read-more {
    margin-top: 18px;

    color: #173c2c;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .article-card {
      grid-template-columns: 1fr;
      gap: 18px;

      padding: 14px;
    }

    .article-card-image {
      aspect-ratio: 16 / 10;
    }

    .article-card-title {
      font-size: 20px;
    }

    .article-card-description {
      font-size: 15px;
    }
  }
</style>
