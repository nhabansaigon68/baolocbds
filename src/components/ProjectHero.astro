---
interface Props {
  title: string;
  description?: string;
  image: string;
  location?: string;
  status?: string;
  priceUrl?: string;
}

const {
  title,
  description,
  image,
  location,
  status,
  priceUrl,
} = Astro.props;
---

<section class="project-hero">
  <img
    src={image}
    alt={title}
    class="project-hero-image"
    loading="eager"
    fetchpriority="high"
  />

  <div class="project-hero-overlay"></div>

  <div class="project-hero-content">
    <div class="project-hero-inner">

      <p class="project-hero-eyebrow">
        DỰ ÁN · BẢO LỘC
      </p>

      <h1>{title}</h1>

      {description && (
        <p class="project-hero-description">
          {description}
        </p>
      )}

      <div class="project-hero-meta">
        {location && (
          <span>⌖ {location}</span>
        )}

        {status && (
          <span>{status}</span>
        )}
      </div>

      <div class="project-hero-actions">
        {priceUrl && (
          <a href={priceUrl} class="hero-button hero-button-primary">
            Xem giá bán
          </a>
        )}

        <a
          href="https://zalo.me/0965027930"
          target="_blank"
          rel="noopener noreferrer"
          class="hero-button hero-button-secondary"
        >
          Zalo tư vấn
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .project-hero {
    position: relative;
    width: 100%;
    min-height: 600px;
    overflow: hidden;
    background: #171717;
  }

  .project-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(12, 16, 12, 0.82) 0%,
        rgba(12, 16, 12, 0.58) 43%,
        rgba(12, 16, 12, 0.12) 75%,
        rgba(12, 16, 12, 0.04) 100%
      ),
      linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.32) 0%,
        transparent 45%
      );
  }

  .project-hero-content {
    position: relative;
    z-index: 2;
    min-height: 600px;
    display: flex;
    align-items: flex-end;
  }

  .project-hero-inner {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 32px 72px;
  }

  .project-hero-eyebrow {
    margin: 0 0 16px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    color: #fff;
    font-size: clamp(42px, 6vw, 78px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 650;
  }

  .project-hero-description {
    max-width: 680px;
    margin: 24px 0 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 17px;
    line-height: 1.65;
  }

  .project-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .project-hero-meta span {
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(8px);
    color: rgba(255, 255, 255, 0.9);
    font-size: 13px;
  }

  .project-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .hero-button:hover {
    transform: translateY(-1px);
  }

  .hero-button-primary {
    background: #fff;
    color: #171717;
  }

  .hero-button-secondary {
    border: 1px solid rgba(255, 255, 255, 0.42);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 767px) {
    .project-hero,
    .project-hero-content {
      min-height: 560px;
    }

    .project-hero-overlay {
      background:
        linear-gradient(
          0deg,
          rgba(10, 14, 10, 0.88) 0%,
          rgba(10, 14, 10, 0.55) 55%,
          rgba(10, 14, 10, 0.18) 100%
        );
    }

    .project-hero-inner {
      padding: 64px 20px 48px;
    }

    h1 {
      font-size: clamp(38px, 12vw, 54px);
    }

    .project-hero-description {
      font-size: 15px;
      line-height: 1.55;
    }

    .project-hero-actions {
      width: 100%;
    }

    .hero-button {
      flex: 1;
    }
  }
</style>