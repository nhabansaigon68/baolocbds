---
import type { CollectionEntry } from "astro:content";

interface Props {
  currentPost: CollectionEntry<"posts">;
  posts: CollectionEntry<"posts">[];
}

const { currentPost, posts } = Astro.props;

function getPostUrl(post: CollectionEntry<"posts">) {
  if (post.data.category === "thi-truong") {
    return `/thi-truong/${post.id}/`;
  }

  if (post.data.category === "tai-chinh") {
    return `/tai-chinh/${post.id}/`;
  }

  return `/blog/${post.id}/`;
}

const otherPosts = posts.filter((post) => post.id !== currentPost.id);

const relatedPosts = [...otherPosts]
  .sort((a, b) => {
    const aProjectMatch =
      currentPost.data.projectSlug &&
      a.data.projectSlug === currentPost.data.projectSlug
        ? 1
        : 0;

    const bProjectMatch =
      currentPost.data.projectSlug &&
      b.data.projectSlug === currentPost.data.projectSlug
        ? 1
        : 0;

    if (aProjectMatch !== bProjectMatch) {
      return bProjectMatch - aProjectMatch;
    }

    const aCategoryMatch =
      a.data.category === currentPost.data.category ? 1 : 0;

    const bCategoryMatch =
      b.data.category === currentPost.data.category ? 1 : 0;

    if (aCategoryMatch !== bCategoryMatch) {
      return bCategoryMatch - aCategoryMatch;
    }

    return b.data.pubDate.getTime() - a.data.pubDate.getTime();
  })
  .slice(0, 3);

const latestPosts = [...otherPosts]
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  )
  .slice(0, 3);
---

{
  (relatedPosts.length > 0 || latestPosts.length > 0) && (
    <aside class="post-recommendations">
      {relatedPosts.length > 0 && (
        <section>
          <div class="section-heading">
            <p>BÀI LIÊN QUAN</p>
            <h2>Đọc tiếp theo chủ đề.</h2>
          </div>

          <div class="post-list">
            {relatedPosts.map((post) => (
              <a href={getPostUrl(post)} class="post-item">
                <img
                  src={post.data.image.url}
                  alt={post.data.image.alt}
                  loading="lazy"
                />

                <div>
                  <p class="post-meta">
                    {post.data.pubDate.toLocaleDateString("vi-VN")}
                  </p>

                  <h3>{post.data.title}</h3>

                  <p class="post-description">
                    {post.data.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {latestPosts.length > 0 && (
        <section>
          <div class="section-heading">
            <p>MỚI NHẤT</p>
            <h2>Bài viết mới.</h2>
          </div>

          <div class="post-list compact">
            {latestPosts.map((post) => (
              <a href={getPostUrl(post)} class="post-item">
                <img
                  src={post.data.image.url}
                  alt={post.data.image.alt}
                  loading="lazy"
                />

                <div>
                  <p class="post-meta">
                    {post.data.pubDate.toLocaleDateString("vi-VN")}
                  </p>

                  <h3>{post.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </aside>
  )
}

<style>
  .post-recommendations {
    display: grid;
    gap: 64px;
    margin-top: 72px;
    padding-top: 48px;
    border-top: 1px solid rgba(23, 23, 23, 0.1);
  }

  .section-heading {
    margin-bottom: 24px;
  }

  .section-heading p {
    margin: 0 0 8px;
    color: #77766f;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .section-heading h2 {
    margin: 0;
    color: #171717;
    font-size: 30px;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .post-list {
    display: grid;
    gap: 20px;
  }

  .post-item {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }

  .post-item img {
    width: 180px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 14px;
    border: 1px solid rgba(23, 23, 23, 0.08);
    background: #eeece5;
  }

  .post-meta {
    margin: 0 0 8px;
    color: #85847d;
    font-size: 12px;
  }

  .post-item h3 {
    margin: 0;
    color: #171717;
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .post-description {
    margin: 10px 0 0;
    color: #6d6c66;
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 767px) {
    .post-recommendations {
      gap: 48px;
      margin-top: 56px;
      padding-top: 36px;
    }

    .post-item {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 14px;
    }

    .post-item img {
      width: 112px;
      border-radius: 10px;
    }

    .post-item h3 {
      font-size: 17px;
    }

    .post-description {
      display: none;
    }
  }
</style>
