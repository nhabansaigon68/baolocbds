---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArticleListCard from "../../components/ArticleListCard.astro";

const posts = (await getCollection("posts"))
  .filter((post) => post.data.category === "tai-chinh")
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
---

<Layout
  seo={{
    title: "Tài chính Bất động sản | BAO LOC BDS",
    description:
      "Thông tin, phân tích và góc nhìn thực tế về tài chính và bất động sản.",
    image: "/logo.webp",
  }}
>
  <main class="mt-10 max-w-5xl mx-auto px-6">
    <header class="mb-10">
      <h1 class="font-bold text-3xl">
        Tài chính
      </h1>

      <p class="opacity-60 mt-2">
        Thông tin và góc nhìn thực tế về tài chính và bất động sản.
      </p>
    </header>

    <section class="grid grid-cols-1 gap-6">
      {
        posts.map((post) => (
          <ArticleListCard
            href={`/tai-chinh/${post.id}/`}
            title={post.data.title}
            description={post.data.description}
            imageUrl={post.data.image.url}
            imageAlt={post.data.image.alt}
            pubDate={post.data.pubDate}
          />
        ))
      }
    </section>
  </main>
</Layout>
