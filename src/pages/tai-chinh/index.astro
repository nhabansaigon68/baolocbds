---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => post.data.category === "tai-chinh")
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
---

<Layout
  seo={{
    title: "Tài chính Bất động sản | BAO LOC BDS",
    description:
      "Thông tin, phân tích và góc nhìn thực tế về tài chính và bất động sản.",
    image: "/logo.webp",
  }}
>
  <main class="mt-10 max-w-5xl mx-auto px-6">
    <header class="mb-10">
      <h1 class="font-bold text-3xl">
        Tài chính
      </h1>

      <p class="opacity-60 mt-2">
        Thông tin và góc nhìn thực tế về tài chính và bất động sản.
      </p>
    </header>

    <section class="grid grid-cols-1 gap-6">
      {
        posts.map((post) => (
          <article class="border border-black/10 rounded-xl p-6">
            <h2 class="font-semibold text-xl">
              <a href={`/tai-chinh/${post.id}/`}>
                {post.data.title}
              </a>
            </h2>

            <p class="opacity-60 mt-2">
              {post.data.description}
            </p>

            <time
              class="block text-sm opacity-50 mt-3"
              datetime={post.data.pubDate.toISOString()}
            >
              {post.data.pubDate.toLocaleDateString("vi-VN")}
            </time>
          </article>
        ))
      }
    </section>
  </main>
</Layout>
