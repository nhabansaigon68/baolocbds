---
import Layout from "../../../layouts/Layout.astro";
import PostRecommendations from "../../../components/PostRecommendations.astro";
import LeadCapture from "../../../components/LeadCapture.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection("posts"))
    .filter((post) => post.data.category === "thi-truong");

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const allPosts = await getCollection("posts");

const projectSlug = post.data.projectSlug;

const project = projectSlug
  ? (await getCollection("projects")).find(
      (item) => item.id === `${projectSlug}/tong-quan`,
    )
  : undefined;

const projectName =
  project?.data.projectName ??
  project?.data.title ??
  projectSlug;
---

<Layout
  seo={{
    title: `${post.data.title} | BAO LOC BDS`,
    description: post.data.description,
    image: post.data.image.url,
  }}
>
  <main class="article-shell">
  <header class="article-header">
    <div class="article-kicker">
      <a href="/thi-truong/">Thị trường</a>
      <span aria-hidden="true">•</span>
      <time datetime={post.data.pubDate.toISOString()}>
        {post.data.pubDate.toLocaleDateString("vi-VN")}
      </time>

      {
        post.data.readingTime && (
          <>
            <span aria-hidden="true">•</span>
            <span>{post.data.readingTime} phút đọc</span>
          </>
        )
      }
    </div>

    <h1>{post.data.title}</h1>

    <p class="article-dek">
      {post.data.description}
    </p>
  </header>

  <figure class="article-cover">
    <img
      src={post.data.image.url}
      alt={post.data.image.alt}
      width="1200"
      height="675"
      loading="eager"
    />
  </figure>

  <div class="article-divider"></div>

  <article class="article-body">
    <Content />
  </article>

  {projectSlug && projectName && (
    <LeadCapture
      title={`Nhận thông tin ${projectName}`}
      description="Để lại số điện thoại, BAO LOC BDS sẽ gửi thông tin mới nhất về dự án và hỗ trợ bạn khi cần xem thực tế."
      intent={`project:${projectSlug}`}
      buttonLabel="Nhận thông tin dự án"
    />
  )}

  <PostRecommendations
    currentPost={post}
    posts={allPosts}
  />
</main>

<style>
  .article-shell {
    width: min(100% - 32px, 860px);
    margin: 72px auto 96px;
  }

  .article-header {
    max-width: 780px;
  }

  .article-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-bottom: 22px;
    color: #6f746f;
    font-size: 13px;
    line-height: 1.5;
  }

  .article-kicker a {
    color: #173c2c;
    font-weight: 700;
    text-decoration: none;
  }

  .article-header h1 {
    margin: 0;
    color: #171717;
    font-size: clamp(36px, 6vw, 58px);
    line-height: 1.05;
    letter-spacing: -0.045em;
    font-weight: 750;
  }

  .article-dek {
    max-width: 720px;
    margin: 24px 0 0;
    color: #626761;
    font-size: 20px;
    line-height: 1.65;
  }

  .article-cover {
    margin: 38px 0 0;
    overflow: hidden;
    border-radius: 18px;
  }

  .article-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 560px;
    object-fit: cover;
  }

  .article-divider {
    width: 100%;
    height: 1px;
    margin: 40px 0 44px;
    background: rgba(23, 23, 23, 0.1);
  }

  .article-body {
    max-width: 720px;
    color: #2c2e2c;
    font-size: 18px;
    line-height: 1.82;
  }

  .article-body :global(p) {
    margin: 0 0 24px;
  }

  .article-body :global(h2) {
    margin: 52px 0 18px;
    color: #171717;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 720;
  }

  .article-body :global(h3) {
    margin: 36px 0 14px;
    color: #171717;
    font-size: 22px;
    line-height: 1.3;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 26px;
    padding-left: 26px;
  }

  .article-body :global(ul) {
    list-style-type: disc;
  }

  .article-body :global(ol) {
    list-style-type: decimal;
  }

  .article-body :global(li) {
    margin: 8px 0;
    padding-left: 4px;
  }

  .article-body :global(li::marker) {
    color: #173c2c;
    font-weight: 700;
  }

  .article-body :global(strong) {
    color: #171717;
    font-weight: 700;
  }

  .article-body :global(a) {
    color: #173c2c;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .article-body :global(blockquote) {
    margin: 36px 0;
    padding: 4px 0 4px 22px;
    border-left: 3px solid #173c2c;
    color: #5b605b;
    font-size: 19px;
  }

  @media (max-width: 767px) {
    .article-shell {
      width: min(100% - 28px, 860px);
      margin: 48px auto 72px;
    }

    .article-header h1 {
      font-size: clamp(34px, 11vw, 44px);
    }

    .article-dek {
      margin-top: 18px;
      font-size: 18px;
      line-height: 1.6;
    }

    .article-cover {
      margin-top: 28px;
      border-radius: 14px;
    }

    .article-cover img {
      max-height: none;
      object-fit: contain;
    }

    .article-divider {
      margin: 32px 0 34px;
    }

    .article-body {
      font-size: 17px;
      line-height: 1.78;
    }

    .article-body :global(h2) {
      margin-top: 42px;
      font-size: 25px;
    }
  }
</style>
</Layout>
