---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import { ClientRouter } from "astro:transitions";
import { navBarLinks, identity } from "../config";
import type { SEOInfo } from "../types/config";

interface Props {
  seo: SEOInfo;
  smoothNavigation?: boolean;
}

const {
  seo,
  smoothNavigation = false,
} = Astro.props;

const siteUrl = "https://baolocbds.com";

const canonicalUrl = new URL(
  Astro.url.pathname,
  siteUrl
).toString();

const socialImage = new URL(
  seo.image,
  siteUrl
).toString();

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: identity.name,
  url: siteUrl,
  inLanguage: "vi-VN",
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: identity.name,
  url: siteUrl,
  logo: new URL(identity.logo, siteUrl).toString(),
  email: identity.email,
};
---

<script>
  const linkMenuButton = document.getElementById(
    "link-menu-button"
  ) as HTMLButtonElement;

  const linkMenu = document.getElementById(
    "link-menu"
  ) as HTMLDivElement;

  const openIndicator = document.getElementById(
    "open-indicator"
  ) as HTMLSpanElement;

  linkMenuButton?.addEventListener("click", () => {
    if (linkMenu.classList.contains("opacity-0")) {
      linkMenu.classList.remove("pointer-events-none");
      linkMenu.classList.remove("opacity-0");
      openIndicator.innerText = "−";
    } else {
      linkMenu.classList.add("pointer-events-none");
      linkMenu.classList.add("opacity-0");
      openIndicator.innerText = "+";
    }
  });

  document.addEventListener("click", (event) => {
    const target = event.target as Node;

    const isLinkMenuButtonClicked =
      linkMenuButton?.contains(target);

    const isLinkMenuClicked =
      linkMenu?.contains(target);

    if (!isLinkMenuButtonClicked && !isLinkMenuClicked) {
      linkMenu?.classList.add("pointer-events-none");
      linkMenu?.classList.add("opacity-0");

      if (openIndicator) {
        openIndicator.innerText = "+";
      }
    }
  });
</script>

<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta name="generator" content={Astro.generator} />

    <title>{seo.title}</title>

    <meta
      name="description"
      content={seo.description}
    />

    <meta property="og:title" content={seo.title} />

    <meta
      property="og:description"
      content={seo.description}
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />

    <link rel="canonical" href={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta
      name="twitter:description"
      content={seo.description}
    />
    <meta name="twitter:image" content={socialImage} />

    {smoothNavigation && <ClientRouter fallback="animate" />}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
  </head>

  <body>

    <!-- HEADER -->
    <header
      class="site-header"
      transition:persist="site-header"
    >

      <div
        class="w-full max-w-[1440px] mx-auto px-5 sm:px-6 lg:px-8"
      >

        <div class="h-20 flex items-center justify-between">

          <!-- LOGO -->
          <a
            href="/"
            class="flex items-center gap-3 shrink-0"
            aria-label="BAO LOC BDS - Trang chủ"
          >

            <img
              src="/images/logo.png"
              alt="BAO LOC BDS"
              class="site-logo"
            />

          </a>


          <!-- DESKTOP NAVIGATION -->
          <nav class="hidden md:block">

            <ul class="flex items-center gap-1 lg:gap-2">

              {
                navBarLinks.map((link) => (
                  <li>
                    <a
                      class="nav-link"
                      href={link.url}
                      target={
                        link.external
                          ? "_blank"
                          : "_self"
                      }
                    >
                      {link.title}
                    </a>
                  </li>
                ))
              }

            </ul>

          </nav>


          <!-- CONTACT -->
          <div class="hidden md:flex items-center gap-2">

            <!-- PHONE -->
            <a
              href="tel:0965027930"
              class="contact-button"
              aria-label="Gọi Phước - 096 502 7930"
            >

              <Icon
                name="mdi:phone-outline"
                width={20}
                height={20}
              />

              <span>
                096 502 7930
              </span>

            </a>


            <!-- ZALO -->
            <a
              href="https://zalo.me/0965027930"
              class="contact-button"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Liên hệ Zalo"
            >

            </a>

          </div>


          <!-- MOBILE MENU -->
          <div class="relative md:hidden">

            <button
              id="link-menu-button"
              type="button"
              class="mobile-menu-button"
              aria-label="Mở menu"
            >

              Menu

              <span id="open-indicator">
                +
              </span>

            </button>


            <div
              id="link-menu"
              class="mobile-menu opacity-0 pointer-events-none"
            >

              <ul>

                {
                  navBarLinks.map((link) => (
                    <li>
                      <a
                        class="mobile-nav-link"
                        href={link.url}
                        target={
                          link.external
                            ? "_blank"
                            : "_self"
                        }
                      >
                        {link.title}
                      </a>
                    </li>
                  ))
                }

              </ul>


              <!-- MOBILE CONTACT -->
              <div
                class="mt-2 pt-2 border-t border-gray-200"
              >

                <!-- PHONE -->
                <a
                  href="tel:0965027930"
                  class="mobile-nav-link flex items-center gap-3"
                >

                  <Icon
                    name="mdi:phone-outline"
                    width={20}
                    height={20}
                  />

                  <span>
                    096 502 7930
                  </span>

                </a>


                <!-- ZALO -->
                <a
                  href="https://zalo.me/0965027930"
                  class="mobile-nav-link flex items-center gap-3"
                  target="_blank"
                  rel="noopener noreferrer"
                >

                  <span>
                    💬
                  </span>

                  <span>
                    Nhắn zalo
                  </span>

                </a>


                <!-- EMAIL -->
                <a
                  href={`mailto:${identity.email}`}
                  class="mobile-nav-link flex items-center gap-3"
                >

                  <Icon
                    name="mdi:email-outline"
                    width={20}
                    height={20}
                  />

                  <span>
                    Email
                  </span>

                </a>

              </div>

            </div>

          </div>

        </div>

      </div>

    </header>


    <!-- MAIN -->
    <main class="mb-32">

      <slot />

    </main>


    <!-- FOOTER -->
    <footer class="site-footer">

      <div
        class="max-w-[1440px] mx-auto px-5 sm:px-6 lg:px-8 py-10"
      >

        <div
          class="flex flex-col sm:flex-row gap-4 sm:items-center sm:justify-between"
        >

          <!-- BRAND -->
          <div>

            <div class="font-semibold">
              BAO LOC BDS
            </div>

            <div class="text-sm text-gray-500 mt-1">
              Bất động sản & góc nhìn về Bảo Lộc
            </div>

          </div>


          <!-- CONTACT LINKS -->
          <div
            class="flex flex-col sm:flex-row sm:items-center gap-3 text-sm text-gray-500"
          >

            <!-- PHONE -->
            <a
              href="tel:0965027930"
              class="footer-contact-link"
            >
              096 502 7930
            </a>


            <span class="hidden sm:inline">
              •
            </span>


            <!-- ZALO -->
            <a
              href="https://zalo.me/0965027930"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-contact-link"
            >
              Nhắn Zalo
            </a>


            <span class="hidden sm:inline">
              •
            </span>


            <!-- EMAIL -->
            <a
              href={`mailto:${identity.email}`}
              class="footer-contact-link"
            >
              {identity.email}
            </a>

          </div>

        </div>

      </div>

    </footer>

  </body>
</html>


<style is:global>

  @import url(
    "https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
  );


  html {

    font-family: "Inter", sans-serif;

    background: #f8f7f3;

    color: #171717;

  }


  body {

    margin: 0;

    background: #f8f7f3;

    color: #171717;

  }


  * {

    -webkit-font-smoothing: antialiased;

    box-sizing: border-box;

  }


  /* HEADER */

  .site-header {

    background: rgba(248, 247, 243, 0.92);

    border-bottom: 1px solid #e7e5df;

    backdrop-filter: blur(12px);

    position: relative;

    z-index: 50;

  }


  .site-logo {

    width: 200px;

    height: auto;

    display: block;

  }


  /* NAVIGATION */

  .nav-link {

    display: block;

    padding: 10px 14px;

    border-radius: 8px;

    color: #4b4b46;

    font-size: 14px;

    transition:
      background-color 200ms,
      color 200ms;

  }


  .nav-link:hover {

    background: #eeece5;

    color: #171717;

  }


  /* CONTACT */

  .contact-button {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    padding: 9px 12px;

    border-radius: 9px;

    color: #4b4b46;

    font-size: 14px;

    transition:
      background-color 200ms,
      color 200ms;

    white-space: nowrap;

  }


  .contact-button:hover {

    background: #eeece5;

    color: #171717;

  }


  /* MOBILE MENU BUTTON */

  .mobile-menu-button {

    padding: 9px 13px;

    border-radius: 8px;

    color: #3f3f3a;

    transition:
      background-color 200ms;

  }


  .mobile-menu-button:hover {

    background: #eeece5;

  }


  /* MOBILE MENU */

  .mobile-menu {

    position: absolute;

    right: 0;

    top: 48px;

    width: 230px;

    padding: 8px;

    border-radius: 14px;

    background: #ffffff;

    border: 1px solid #e4e2dc;

    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.10);

    transition:
      opacity 200ms;

    z-index: 50;

  }


  .mobile-nav-link {

    display: block;

    padding: 12px 14px;

    border-radius: 9px;

    color: #44443f;

    transition:
      background-color 200ms,
      color 200ms;

  }


  .mobile-nav-link:hover {

    background: #f1f0eb;

    color: #171717;

  }


  /* FOOTER */

  .site-footer {

    border-top: 1px solid #e4e2dc;

    background: #f3f1eb;

  }


  .footer-contact-link {

    transition:
      color 200ms;

  }


  .footer-contact-link:hover {

    color: #171717;

  }


  /* BLOG */

  .hover-underline {

    text-decoration:
      underline 1px rgba(23, 23, 23, 0);

    text-underline-offset: 5px;

    transition:
      text-decoration-color 300ms;

  }


  .post:hover .hover-underline {

    text-decoration-color:
      rgba(23, 23, 23, 1);

  }


  /* TEXT COLORS */

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p,
  a,
  span {

    color: inherit;

  }


  code {

    font-family:
      Menlo,
      Monaco,
      Lucida Console,
      Liberation Mono,
      DejaVu Sans Mono,
      Bitstream Vera Sans Mono,
      Courier New,
      monospace;

  }

</style>